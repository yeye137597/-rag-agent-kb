# =========================
# Production Environment
# =========================

APP_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ENABLE_PUBLIC_REGISTER=false

# LLM provider configuration
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_with_your_production_api_key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# Embedding configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# HuggingFace cache path inside Docker container
HF_HOME=/app/.cache/huggingface

# JWT secret for login token signing
# IMPORTANT: replace this with a long random secret in production
JWT_SECRET_KEY=replace_with_a_long_random_secret

# CORS allowed frontend origins
# Examples:
# ALLOWED_ORIGINS=http://your-server-ip
# ALLOWED_ORIGINS=https://kb.example.com
ALLOWED_ORIGINS=http://localhost

# Backward-compatible DeepSeek variables
# New deployments should prefer LLM_* variables above
DEEPSEEK_API_KEY=replace_with_your_production_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

